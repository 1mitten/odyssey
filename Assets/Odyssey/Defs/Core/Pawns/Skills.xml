<?xml version="1.0" encoding="utf-8"?>
<!--
  Both skills share one curve, one cap and one ladder, because the reference does (a-01: twelve
  skills, one formula). They are two Defs inheriting one abstract parent rather than one shared
  record, so that the day a design wants cutting to learn faster than hauling it is an override
  of one element and not a change to any code.

  EXPERIENCE IS IN THOUSANDTHS OF A POINT. a-01 measures a level in points (1,000 to leave level
  0, 265,000 to reach 20) and a tick of work in fractions of one, and a passion multiplier of
  0.35 applied to a fraction rounds to nothing in integers. So a point is 1,000 here, the way a
  need's bar is 1,000, and every rate below is in the same units. Nothing is a float, so it all
  hashes and saves without a rounding question.

  experienceToAdvance is a table rather than a formula on purpose: these are content, and content
  that is generated by a loop cannot be overridden by a mod or corrected by a measurement without
  editing the loop. a-01 gives 1,000 x (L + 1) points from L to L + 1 and a cumulative 265,000 to
  reach 20, and those two only agree if the slope doubles from level 10: the first ten steps sum
  to 55,000, so the last ten must sum to 210,000, which 12,000 rising by 2,000 a step to 30,000
  does exactly. The second slope is therefore ASSUMED from the two figures, not read from a table.

  decayPerDay is indexed by level, so the first ten entries are zero and the ladder begins at
  decayFromLevel. a-01 measured the two ends — about 30 points a day at level 10 and about 3,600
  at 20 — and the nine between are ASSUMED, a geometric ladder (x1.61 a level) until the full
  table is fetched.
-->
<Defs>

  <SkillDef Name="SkillBase" Abstract="true">
    <maxLevel>20</maxLevel>
    <gainPerMilleByPassion>
      <li>350</li>
      <li>1000</li>
      <li>1500</li>
    </gainPerMilleByPassion>
    <dailySoftCap>4000000</dailySoftCap>
    <overCapGainPerMille>200</overCapGainPerMille>
    <decayFromLevel>10</decayFromLevel>
    <experienceToAdvance>
      <li>1000000</li>
      <li>2000000</li>
      <li>3000000</li>
      <li>4000000</li>
      <li>5000000</li>
      <li>6000000</li>
      <li>7000000</li>
      <li>8000000</li>
      <li>9000000</li>
      <li>10000000</li>
      <li>12000000</li>
      <li>14000000</li>
      <li>16000000</li>
      <li>18000000</li>
      <li>20000000</li>
      <li>22000000</li>
      <li>24000000</li>
      <li>26000000</li>
      <li>28000000</li>
      <li>30000000</li>
    </experienceToAdvance>
    <decayPerDay>
      <li>0</li>
      <li>0</li>
      <li>0</li>
      <li>0</li>
      <li>0</li>
      <li>0</li>
      <li>0</li>
      <li>0</li>
      <li>0</li>
      <li>0</li>
      <li>30000</li>
      <li>48000</li>
      <li>78000</li>
      <li>126000</li>
      <li>203000</li>
      <li>328000</li>
      <li>530000</li>
      <li>855000</li>
      <li>1380000</li>
      <li>2230000</li>
      <li>3600000</li>
    </decayPerDay>
  </SkillDef>

  <!--
    The labels are the work types' own words, which the naming registry already carries as
    ui.work.hauling and ui.work.cutting. Nothing displays a skill yet: the HUD's Skills tab is
    disabled because PawnView does not carry one (OQ-45).
  -->
  <SkillDef ParentName="SkillBase">
    <defName>Skill_Hauling</defName>
    <label>hauling</label>
  </SkillDef>

  <SkillDef ParentName="SkillBase">
    <defName>Skill_Cutting</defName>
    <label>cutting</label>
  </SkillDef>


  <SkillDef ParentName="SkillBase">
    <defName>Skill_Mining</defName>
    <label>mining</label>
  </SkillDef>

  <SkillDef ParentName="SkillBase">
    <defName>Skill_Construction</defName>
    <label>construction</label>
  </SkillDef>

  <!--
    The field craft, U47. One skill for sowing and harvest together, as the work type is one
    (docs/design/22-growing.md section 6).
  -->
  <SkillDef ParentName="SkillBase">
    <defName>Skill_Growing</defName>
    <label>growing</label>
  </SkillDef>

  <!--
    Close combat (design 33 section 1), live from the combat contracts step: the Skills row stops
    being greyed out, and the starting roll deals every colonist a level in it. The attacker's
    level reads Combat.xml's hit curve and the defender's its dodge curve; every swing trains it,
    by the weapon's experiencePerSwing. The parent's curve, cap and ladder, like every skill.
  -->
  <SkillDef ParentName="SkillBase">
    <defName>Skill_Melee</defName>
    <label>melee</label>
  </SkillDef>

  <!--
    Tending (docs/design/43-health.md section 5), live from health's H3: the Skills row stops
    being greyed out and the starting roll deals every colonist a level in it. The level reads
    Health.xml's tend quality curve and the Doctor work type's rate; every tend trains it.
  -->
  <SkillDef ParentName="SkillBase">
    <defName>Skill_Medicine</defName>
    <label>medicine</label>
  </SkillDef>

</Defs>
