// The per-instance frustum cull for the indirect foliage path (design 38 §18, d-19).
//
// One dispatch per group of instances that share a mesh, a material and a layer. Every instance
// whose bounding sphere touches all six frustum planes, and whose root is within the draw
// distance of the viewer, has its index appended to _Visible; the renderer then copies the count
// into the indirect arguments, so the draw that follows asks for exactly the kept instances.
//
// Ours: a sphere against six planes, the same test Unity's own culling applies to a box, and the
// same inward-facing planes GeometryUtility.CalculateFrustumPlanes returns.
#pragma kernel Cull

StructuredBuffer<float4x4> _Instances;
AppendStructuredBuffer<uint> _Visible;

float4 _Planes[6];        // xyz the inward normal, w the distance, as UnityEngine.Plane
float4 _CentreRadius;     // xyz the mesh's bounds centre in object space, w its radius there
float4 _Viewer;           // xyz the viewer, w the draw distance squared (negative for none)
uint _Count;

[numthreads(64, 1, 1)]
void Cull(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _Count) return;

    float4x4 m = _Instances[i];
    float3 centre = mul(m, float4(_CentreRadius.xyz, 1.0)).xyz;
    // Uniform scale: the length of any basis column is the scale.
    float scale = length(float3(m._m00, m._m10, m._m20));
    float radius = _CentreRadius.w * scale;

    [unroll]
    for (int p = 0; p < 6; p++)
    {
        if (dot(_Planes[p].xyz, centre) + _Planes[p].w < -radius) return;
    }

    if (_Viewer.w >= 0.0)
    {
        float3 root = float3(m._m03, m._m13, m._m23);
        float3 d = root - _Viewer.xyz;
        if (dot(d, d) > _Viewer.w) return;
    }

    _Visible.Append(i);
}
