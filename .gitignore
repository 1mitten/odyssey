# Odyssey — Unity project at the repository root.
# Standard Unity ignores, plus the licensed-asset boundary at the bottom.

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Tt]estResults/

# Addressables / streaming build output
/Assets/AddressableAssetsData/*/*.bin*
/Assets/StreamingAssets/aa.meta
/Assets/StreamingAssets/aa/*

# IDE and generated solution files (Unity regenerates them)
/.vs/
/.vscode/
/.idea/
/.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Build outputs and crash files
*.apk
*.aab
*.app
crashlytics-build.properties
/Assets/[Pp]lugins/[Aa]ndroid/[Bb]uild/
*.log

# Unity-MCP plugin dependency DLLs: auto-restored by its resolver on editor
# load (manifest lives beside them), so they never need committing.
/Assets/Plugins/NuGet/
/Assets/Plugins/NuGet.meta

# ---------------------------------------------------------------------------
# Licensed assets stay licensed (brief §1). Synty packs live only here and are
# never committed. Anything under Assets/ that references them must be
# presentation-side; the simulation and its tests must not depend on them.
/Assets/Synty/
/Assets/Synty.meta
*.unitypackage


# Our own dotnet mirror projects (tools/dotnet) are committed; Unity-generated ones are not.
!/tools/dotnet/**/*.csproj

# Generated icon placeholders: docs/design/09-ui-and-input.md section 7 requires these to be
# regenerated rather than committed, because otherwise every icon-key rename churns binaries.
/Assets/Art/Ui/generated/
/Assets/Art/Ui/generated.meta

# Generated icon contact sheets for review. tools/icons/icons.py contact rebuilds them.
/art-source/icons/contact/

# Python bytecode from tools/
__pycache__/
*.py[cod]
